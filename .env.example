# ─────────────────────────────────────────────────────────────────
#  HR Policy Assistant — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# Google Gemini API Key (required)
# Get one from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Path to the Enso Group HR Policy Manual PDF (relative to project root)
PDF_PATH=data/hr_policy.pdf

# Directory where ChromaDB will persist its data
CHROMA_DIR=vectorstore

# Name of the ChromaDB collection
COLLECTION_NAME=hr_policy

# ── RAG Tuning (optional — sensible defaults are built-in) ────────
# Number of characters per text chunk
CHUNK_SIZE=800

# Character overlap between consecutive chunks
CHUNK_OVERLAP=150

# Number of top-K chunks to retrieve per query
TOP_K=5

# ── Server (optional) ─────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# ── Model names (do not change unless you know what you are doing) ─
# Confirmed working as of October 2026:
EMBEDDING_MODEL=models/gemini-embedding-001
CHAT_MODEL=gemini-2.5-flash
